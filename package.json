{
  "name": "fit-check",
  "version": "1.0.0",
  "private": true,
  "description": "Fit Check - a rule-based Dialogflow ES chatbot that helps college students decide if an EV fits, with optional local-LLM polish.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:mock": "DIALOGFLOW_MOCK=1 node scripts/dev-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:agent": "node agent/build-agent.mjs",
    "push:agent": "node agent/push-agent.mjs",
    "gateway": "node pc-gateway/server.mjs"
  },
  "dependencies": {
    "google-auth-library": "^9.15.1"
  }
}
