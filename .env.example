# Copy to .env for local runs. On Vercel, add these under Project -> Settings -> Environment Variables.
# Never commit .env or your service-account JSON to GitHub.

# ---------- Dialogflow (required) ----------
# "es" for Dialogflow ES (classic console), "cx" for Dialogflow CX / Conversational Agents
DIALOGFLOW_AGENT_TYPE=es
DIALOGFLOW_PROJECT_ID=your-gcp-project-id
DIALOGFLOW_LOCATION=global
# CX only - the agent ID from the agent's URL in the CX console
DIALOGFLOW_AGENT_ID=
DIALOGFLOW_LANGUAGE=en
# Paste the WHOLE service-account JSON on one line (or base64-encode it)
GOOGLE_CREDENTIALS=

# Local testing without Google: set to 1 to use a fake keyword matcher (never on Vercel)
DIALOGFLOW_MOCK=0

# ---------- Local AI on your PC (optional - site works rule-based-only without it) ----------
# Option A, Open WebUI:   https://<your-openwebui-host>/api/chat/completions
# Option B, pc-gateway:   https://<your-tunnel-host>/v1/chat/completions
LLM_CHAT_URL=
LLM_API_KEY=
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_MS=20000
# Intents that must always show the exact Dialogflow wording (comma separated)
NO_POLISH_INTENTS=Default Welcome Intent

# ---------- Optional ----------
BOT_NAME=Fit Check
BOT_DOMAIN=helping first-time electric-vehicle buyers through the Tesla customer journey
RATE_LIMIT_PER_MIN=20
